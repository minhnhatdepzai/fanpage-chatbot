# Qwen3-4B-Instruct-2507 lượng tử hóa 4-bit (Q4_K_M, ~2,5 GB) cho Ollama.
# num_ctx 8192: system prompt + nguồn tham khảo + lịch sử ~2-3k token; Ollama CẮT phần đầu prompt nếu vượt num_ctx.
#   ollama create fanpage-qwen3-4b-q4 -f serving/ollama/Modelfile
FROM qwen3:4b-instruct-2507-q4_K_M
PARAMETER num_ctx 8192
PARAMETER top_k 20
