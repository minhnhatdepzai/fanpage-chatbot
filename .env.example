# ============================================================================
# fanpage-chatbot - MẪU cấu hình. Sao chép thành .env rồi điền giá trị THẬT trên máy:
#     cp .env.example .env && chmod 600 .env
# KHÔNG commit .env, KHÔNG dán giá trị bí mật vào chat/issue/log.
# Tạo chuỗi ngẫu nhiên:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================================

# dev | test | production  (production bắt buộc đủ bí mật, mặc định gửi tin cho mọi người)
APP_ENV=dev
LOG_LEVEL=INFO
# Ghi nội dung tin nhắn vào log? Mặc định false.
LOG_CONTENT=false
API_HOST=127.0.0.1
API_PORT=8000

# ---------------------------------------------------------------- PostgreSQL
# Mật khẩu cho container postgres (compose.yaml đọc biến này)
POSTGRES_PASSWORD=<chuoi-ngau-nhien>
DATABASE_URL=postgresql+psycopg://chatbot:<chuoi-ngau-nhien>@127.0.0.1:55432/chatbot

# ---------------------------------------------------------------- Meta / Messenger
# App ID (không bí mật): App Dashboard > App settings > Basic
META_APP_ID=
# App Secret (BÍ MẬT): App Dashboard > App settings > Basic > App secret. Dùng để xác minh chữ ký webhook.
META_APP_SECRET=
# Page ID (không bí mật). `botctl meta check` in ra Page ID của token.
META_PAGE_ID=
# Page Access Token (BÍ MẬT, dạng EAA...): App Dashboard > Messenger > Messenger API Settings > Generate token.
# Chỉ dùng để GỬI tin Messenger. KHÔNG phải API key của mô hình AI.
META_PAGE_ACCESS_TOKEN=
# Verify Token: chuỗi NGẪU NHIÊN do bạn tự đặt, nhập giống hệt vào ô "Verify token" khi cấu hình webhook.
META_VERIFY_TOKEN=<chuoi-ngau-nhien>
META_GRAPH_API_VERSION=v26.0

# disabled | allowlist | all  (mặc định: allowlist ở dev/test, all ở production)
MESSENGER_SEND_MODE=allowlist
# PSID tài khoản KIỂM THỬ được phép nhận tin khi SEND_MODE=allowlist (phân tách bằng dấu phẩy).
# Lấy PSID: nhắn thử vào Page rồi chạy `uv run botctl conversations list --show-psid`.
MESSENGER_ALLOWED_PSIDS=
MESSENGER_TYPING_INDICATOR=true
# Quản trị viên trả lời từ hộp thư Page -> tự dừng bot trong cuộc hội thoại đó
AUTO_HANDOFF_ON_HUMAN_REPLY=true
# (Tùy chọn) Webhook nhận thông báo khi người dùng muốn gặp quản trị viên (Slack/Discord/Google Chat...).
# Chỉ khi thông báo gửi thành công bot mới nói "đã báo cho quản trị viên".
HANDOFF_NOTIFY_WEBHOOK_URL=
# Tự bật lại bot sau N giờ handoff (0 = chỉ bật lại thủ công)
HANDOFF_AUTO_RESUME_HOURS=0

# ---------------------------------------------------------------- Chính sách hội thoại
REPLY_MAX_AGE_SECONDS=600
# Chờ ngắn để gom các tin liên tiếp; tăng lại nếu người dùng thường nhắn nhiều mảnh.
DEBOUNCE_SECONDS=0.5
DEBOUNCE_MAX_SECONDS=2.0
WORKER_POLL_INTERVAL_SECONDS=0.2
MAX_BOT_MESSAGES_PER_MINUTE=6
AI_DISCLOSURE_GAP_HOURS=24
FALLBACK_COOLDOWN_SECONDS=600

# ---------------------------------------------------------------- Độ chính xác (kho kiến thức có nguồn)
# Thư mục các tệp *.yaml; mỗi mục BẮT BUỘC có "source". Bot chỉ khẳng định sự kiện có trong đây và tự gắn link nguồn.
# KNOWLEDGE_DIR=/duong/dan/tuyet/doi   (mặc định: config/knowledge trong dự án)
KNOWLEDGE_TOP_K=3
# Câu hỏi kiến thức KHÔNG có nguồn trong kho:
#   annotate = vẫn trả lời nhưng luôn gắn ghi chú "chưa có nguồn kiểm chứng"
#   strict   = không trả lời đoán, nói rõ chưa có nguồn (an toàn nhất, nhưng trả lời được ít câu hơn)
GROUNDING_MODE=annotate

# ---------------------------------------------------------------- Model (LangChain)
# openai_compatible (model server local của dự án / vLLM / Ollama / OpenAI...) | anthropic | fake
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://127.0.0.1:8100/v1
LLM_MODEL=qwen3-4b-instruct-2507
# Để trống khi dùng model server local (tự dùng MODEL_SERVER_API_KEY)
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
# Thấp = ít bịa hơn (model card Qwen gợi ý 0.7 cho hội thoại tự do).
LLM_TEMPERATURE=0.3
# Model dự phòng khi model server không phản hồi: Ollama + Qwen3-4B Q4_K_M (serving/ollama/Modelfile). Trống = tắt.
LLM_FALLBACK_BASE_URL=http://127.0.0.1:11434/v1
LLM_FALLBACK_MODEL=fanpage-qwen3-4b-q4
# Trần độ dài, không phải số token bắt buộc; câu trả lời dài cần thêm thời gian sinh.
LLM_MAX_OUTPUT_TOKENS=900
# Chỉ khi LLM_PROVIDER=anthropic (cài: uv sync --extra anthropic) và đặt LLM_MODEL tương ứng
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- Model server local (serving/)
MODEL_SERVER_HOST=127.0.0.1
MODEL_SERVER_PORT=8100
MODEL_SERVER_API_KEY=<chuoi-ngau-nhien>
BASE_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
BASE_MODEL_REVISION=cdbee75f17c01a7cc42f958dc650907174af0554
SERVED_MODEL_NAME=qwen3-4b-instruct-2507

# ---------------------------------------------------------------- Bộ nhớ hội thoại
MEMORY_MAX_CONTEXT_TOKENS=3000
MEMORY_SUMMARY_TRIGGER_TOKENS=2200
MEMORY_KEEP_RECENT_MESSAGES=8

# ---------------------------------------------------------------- Quản trị & riêng tư
# Khóa Bearer cho /admin (>= 24 ký tự). Trống = khóa toàn bộ admin API.
ADMIN_API_KEY=<chuoi-ngau-nhien>
# Khóa HMAC tạo định danh giả danh (user_ref) cho log/trace/dữ liệu xuất. Đổi khóa = đổi mọi user_ref.
PSEUDONYM_SECRET=<chuoi-ngau-nhien-dai>
# Tự xóa hội thoại không hoạt động sau N ngày (0 = tắt)
DATA_RETENTION_DAYS=0
CHECKPOINT_RETENTION_HOURS=72

# ---------------------------------------------------------------- Langfuse (tùy chọn)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Cloud EU: https://cloud.langfuse.com | US: https://us.cloud.langfuse.com | self-host: http://localhost:3000
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# false = chỉ gửi metadata; true = gửi nội dung ĐÃ che PII/bí mật
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_SAMPLE_RATE=1.0

# ---------------------------------------------------------------- Kaggle
# CHỈ đường dẫn tới kaggle.json (không sao chép credential vào dự án). Mặc định: ~/.kaggle/kaggle.json
# KAGGLE_JSON_PATH=/duong/dan/tuyet/doi/kaggle.json

# ---------------------------------------------------------------- RAG tài liệu + ảnh (chạy trên máy có GPU)
# Tìm đoạn tài liệu PDF/Word trong pgvector (cần model server nạp embedding)
RAG_DOCS_ENABLED=true
# DOC_MIN_SIMILARITY=0.40          # hiệu chỉnh bằng: uv run botctl docs search "<câu hỏi>"

# Khung chat website: bật/tắt và tên miền được nhúng widget (CORS, phân tách dấu phẩy)
WEB_CHAT_ENABLED=true
# WEB_ALLOWED_ORIGINS=https://example.vn,https://www.example.vn

# Ảnh: OCR (EasyOCR) + YOLO COCO (tự tải lần đầu) + YOLO tự train (tùy chọn, tệp .pt KHÔNG có trong git)
VISION_ENABLED=true
# VISION_CUSTOM_WEIGHTS=artifacts/vision/edu-ent-v3-yolo26n-20260924-003644.pt
# VISION_CUSTOM_MIN_CONF=0.6
# Tin chỉ có ảnh: chờ thêm N giây để gộp với câu hỏi gõ ngay sau đó
DEBOUNCE_ATTACHMENT_SECONDS=6.0
